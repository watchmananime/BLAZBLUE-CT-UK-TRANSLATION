#. Source: story/storytext_ex05 (data/Story/Text/eng/storytext_ex05.pac)
#. Source: story/storytext_mainrg (data/Story/Text/eng/storytext_mainrg.pac)
#. Speaker: Narrator
#. Context: Ragna story route (POV: Ragna)
#. JA: グサッ！
msgctxt "RGN5_068"
msgid "*Stab*"
msgstr "*Хрясь!*"

#. Key: RGN5_069
#. Source: story/storytext_ex00 (data/Story/Text/eng/storytext_ex00.pac)
#. Source: story/storytext_ex01 (data/Story/Text/eng/storytext_ex01.pac)
#. Source: story/storytext_ex02 (data/Story/Text/eng/storytext_ex02.pac)
