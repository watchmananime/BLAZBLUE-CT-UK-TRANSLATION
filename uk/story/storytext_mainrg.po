#. JA: ！、お……い、に……げろ……！
#. JA: ！！　お……い、に……げろ……！
msgctxt "RGN2_041"
msgid "Hey...run away...!"
msgstr "Гей... тікай...!"

#. Key: RGN2_042
#. Source: story/storytext_ex00 (data/Story/Text/eng/storytext_ex00.pac)
