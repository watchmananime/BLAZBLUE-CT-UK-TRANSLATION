msgctxt "CMDLIST_AR_CMD_AR01"
msgid "Release ^mCMDA; or ^mCMDB; or ^mCMDC; or ^mCMDD; while the opponent is cursed"
msgstr "Прокляття:^mCMDSpace;відпустити ^mCMDA; / ^mCMDB; / ^mCMDC; / ^mCMDD;"

#. Key: CMDLIST_AR_TEXT_AR01
#. Source: menu/gr_johchu_eng (data/gr/gr_johchu_eng.pac:font.pac/text.fontpac/text.txt)
