msgid "^mCMD2;^mCMD2;^mCMD2; ＋ ^mCMDD;"
msgstr "^mCMD2;^mCMD2;^mCMD2; ＋ ^mCMDD;"

#. Key: CMDLIST_NY_GAUGE_NY8
#. Source: menu/gr_johchu_eng (data/gr/gr_johchu_eng.pac:font.pac/text.fontpac/text.txt)
