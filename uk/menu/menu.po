msgstr "Недостатньо вільного місця. Звільнити місце?"

#. Key: SVSQ_SaveDone
#. Source: menu/gr_johchu_eng (data/gr/gr_johchu_eng.pac:font.pac/text.fontpac/text.txt)
#. Context: Save & Load
#. JA: 保存が完了しました。
msgctxt "SVSQ_SaveDone"
msgid "Save complete."
msgstr "Збереження завершено."

#. Key: SVSQ_AskRetry
#. Source: menu/gr_johchu_eng (data/gr/gr_johchu_eng.pac:font.pac/text.fontpac/text.txt)
#. Context: Save & Load
#. JA: 保存に失敗しました。^n;再試行しますか？
