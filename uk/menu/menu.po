#. Source: menu/gr_johchu_eng (data/gr/gr_johchu_eng.pac:font.pac/text.fontpac/text.txt)
#. Context: Command List
#. JA: ※ヒートゲージ５０％消費
msgctxt "CMDLIST_NO_GAUGE_NOEL9"
msgid "Uses 50% Heat"
msgstr "Нагрів: −50%"

#. Key: CMDLIST_NO_ICON_NOEL9
#. Source: menu/gr_johchu_eng (data/gr/gr_johchu_eng.pac:font.pac/text.fontpac/text.txt)
#. Context: Command List
