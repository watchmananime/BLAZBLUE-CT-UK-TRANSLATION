msgctxt "NTER_RatingAge"
msgid "Because of age restrictions, you cannot use the network functions."
msgstr "Через вікові обмеження ви не можете користуватися мережевими функціями."

#. Key: NETMSG_ChatRestriction
#. Source: menu/gr_johchu_eng (data/gr/gr_johchu_eng.pac:font.pac/text.fontpac/text.txt)
